# Minimal environment for running the tailor-distro test suite on branch/PR
# builds. Built locally by the Jenkins pipeline; never pushed to a registry.
FROM ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev python3-pip python3-setuptools python3-wheel \
    python3-venv python3-apt git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
